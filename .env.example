# Copy this file to .env and fill in your own values. Never share .env.
BROKER=hivemq
MQTT_URL=mqtts://YOUR-CLUSTER.s1.eu.hivemq.cloud:8883
MQTT_USER=sensor-sim
MQTT_PASS=your-password
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/

# Only needed later when BROKER=aws
AWS_IOT_ENDPOINT=xxxxxxxx-ats.iot.ap-southeast-2.amazonaws.com
AWS_KEY=certs/private.pem.key
AWS_CERT=certs/certificate.pem.crt
AWS_CA=certs/AmazonRootCA1.pem
